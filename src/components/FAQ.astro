---
import { faqs } from '../data/business';
---
<section class="faq-section" aria-labelledby="faq-title">
  <div class="container narrow">
    <h2 id="faq-title">Questions clients ask before they book</h2>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
