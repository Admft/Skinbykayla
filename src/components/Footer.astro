---
import { business } from '../data/business';
---
<footer class="site-footer" id="visit">
  <div class="footer-ribbon" aria-hidden="true"></div>
  <div class="container footer-grid">
    <section>
      <a class="brand footer-brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 60 60" role="img">
            <path d="M8 42c12-2 12-22 24-24 10-1 12 10 22 5" />
            <path d="M7 28c10-6 16-16 28-16 8 0 13 4 18 7" />
            <path d="M11 47c15 6 28-4 42 1" />
          </svg>
        </span>
        <span class="brand-text">SkinByKaylaa</span>
      </a>
      <p class="footer-copy">
        A calm Royse City esthetician studio for skin, brows, lashes, waxing, and self care that feels easy to return to.
      </p>
      <div class="footer-actions">
        <a class="button button-light" href="/booking/">Book now</a>
        <a class="button button-ghost" href={business.reviewLink} target="_blank" rel="noopener">Leave a Google review</a>
      </div>
    </section>

    <section>
      <h2 class="footer-title">Visit</h2>
      <address>
        {business.address.street}<br />
        {business.address.city}, {business.address.region} {business.address.postalCode}
      </address>
      <p>
        <a href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a><br />
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </p>
      <p><a href={business.mapsLink} target="_blank" rel="noopener">Get directions</a></p>
    </section>

    <section>
      <h2 class="footer-title">Hours</h2>
      <ul class="hours-list" aria-label="Business hours">
        {business.hours.map((item) => (
          <li><span>{item.short}</span><span>{item.opens.replace(':00', '')}am - {item.closes === '18:00' ? '6pm' : item.closes}</span></li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="footer-title">Site</h2>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/services/">Service menu</a>
        <a href="/reviews/">Client reviews</a>
        <a href="/booking/">Booking request</a>
        <a href="/ai-search-profile/">AI search profile</a>
        <a href="/llms.txt">llms.txt</a>
      </nav>
    </section>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} SkinByKaylaa. All rights reserved.</p>
    <p>Royse City, TX esthetician studio.</p>
  </div>
</footer>
