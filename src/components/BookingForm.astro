---
import { getClientPairingData } from '../data/addons';
import { business, formatDuration, formatMoney, services } from '../data/business';

interface Props {
  preselectedSlug?: string;
}

const { preselectedSlug } = Astro.props;
const pairingData = getClientPairingData();
---
<form class="booking-form" name="booking-request" method="POST" data-netlify="true" netlify-honeypot="company" action="/thanks/" data-booking-form>
  <input type="hidden" name="form-name" value="booking-request" />
  <p class="hidden-field">
    <label>Company <input name="company" /></label>
  </p>

  <header class="booking-form-header">
    <h3>Appointment Request</h3>
    <p>This form helps Kaylaa understand what you would like to book. Add-ons are optional, and your appointment will be confirmed personally.</p>
  </header>

  <section class="booking-form-section">
    <p class="booking-form-label"><span class="booking-form-step">1</span> Choose your service</p>
    <label class="booking-field booking-field-full">
      <span class="sr-only">Service</span>
      <select name="service" required data-service-select>
        <option value="">Choose a service</option>
        {services.map((service) => (
          <option
            value={`${service.name} - ${formatMoney(service.price)} - ${formatDuration(service.durationMinutes)}`}
            data-slug={service.slug}
            selected={preselectedSlug === service.slug}
          >
            {service.name} - {formatMoney(service.price)} - {formatDuration(service.durationMinutes)}
          </option>
        ))}
      </select>
    </label>
  </section>

  <section class="booking-form-section booking-form-addons">
    <p class="booking-form-label"><span class="booking-form-step">2</span> Add optional comforts</p>
    <p class="addon-placeholder" data-addon-placeholder>
      These appear after you choose a service. No pressure — they are here to help your visit feel more personal.
    </p>
    <div class="addon-panel" data-addon-panel hidden>
      <p class="addon-panel-intro">These are small comfort-focused extras that can help your visit feel more complete. Choose only what feels right.</p>
      <p class="addon-panel-title" data-addon-title></p>
      <p class="addon-panel-hint" data-addon-hint hidden></p>
      <fieldset class="addon-options" data-addon-options></fieldset>
    </div>
    <input type="hidden" name="addons" value="" data-addons-input />
  </section>

  <section class="booking-form-section">
    <p class="booking-form-label"><span class="booking-form-step">3</span> Tell us what works for you</p>
    <div class="form-grid">
      <label class="booking-field">
        <span>Preferred day</span>
        <input type="date" name="preferred_day" />
      </label>
      <label class="booking-field">
        <span>Preferred time</span>
        <select name="preferred_time">
          <option>Morning</option>
          <option>Afternoon</option>
          <option>Evening</option>
          <option>First available</option>
        </select>
      </label>
    </div>
  </section>

  <section class="booking-form-section">
    <p class="booking-form-label">Contact details</p>
    <div class="form-grid">
      <label class="booking-field">
        <span>Your name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label class="booking-field">
        <span>Phone number</span>
        <input name="phone" autocomplete="tel" inputmode="tel" required />
      </label>
    </div>
    <label class="booking-field booking-field-full">
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" />
    </label>
  </section>

  <label class="booking-field booking-field-full">
    <span>Anything Kaylaa should know?</span>
    <textarea name="message" rows="4" placeholder="First wax, sensitive skin, event date, brow goals, questions, etc."></textarea>
  </label>

  <div class="booking-consent">
    <label class="checkbox-row">
      <input type="checkbox" name="text_ok" value="yes" checked />
      <span>It is okay for SkinByKaylaa to text me about this request.</span>
    </label>
  </div>

  <button class="button button-mauve booking-submit" type="submit">Request appointment</button>
  <p class="form-note booking-confirm-note">
    Kaylaa will confirm your appointment personally. Your request is not final until confirmed.
  </p>
  <p class="form-help">
    Need help choosing? <a href={`sms:${business.phoneE164}`}>Text Kaylaa</a> and she will help you pick the right service.
  </p>

  <script type="application/json" id="addon-pairings" set:html={JSON.stringify(pairingData)} />
</form>
