---
import { addOnIntro, getClientPairingData } from '../data/addons';
import { business, formatDuration, formatMoney, services } from '../data/business';

interface Props {
  preselectedSlug?: string;
}

const { preselectedSlug } = Astro.props;
const pairingData = getClientPairingData();
---
<form class="booking-form" name="booking-request" method="POST" data-netlify="true" netlify-honeypot="company" action="/thanks/" data-booking-form>
  <input type="hidden" name="form-name" value="booking-request" />
  <p class="hidden-field">
    <label>Company <input name="company" /></label>
  </p>

  <div class="booking-step booking-step-service">
    <label>
      <span>Service</span>
      <select name="service" required data-service-select>
        <option value="">Choose a service</option>
        {services.map((service) => (
          <option
            value={`${service.name} - ${formatMoney(service.price)} - ${formatDuration(service.durationMinutes)}`}
            data-slug={service.slug}
            selected={preselectedSlug === service.slug}
          >
            {service.name} - {formatMoney(service.price)} - {formatDuration(service.durationMinutes)}
          </option>
        ))}
      </select>
    </label>
  </div>

  <div class="addon-step" data-addon-step hidden>
    <div class="addon-step-copy">
      <h3>Optional add-ons</h3>
      <p>{addOnIntro}</p>
      <p class="addon-step-title" data-addon-title>A few extras that pair well with your service</p>
      <p class="addon-step-hint" data-addon-hint hidden></p>
    </div>
    <fieldset class="addon-options" data-addon-options></fieldset>
    <input type="hidden" name="addons" value="" data-addons-input />
    <div class="addon-step-actions">
      <button class="button button-secondary" type="button" data-addon-skip>No add-ons today</button>
      <button class="button button-primary" type="button" data-addon-continue>Add to my visit</button>
    </div>
  </div>

  <div class="booking-details" data-booking-details hidden>
    <div class="form-grid">
      <label>
        <span>Name</span>
        <input name="name" autocomplete="name" required />
      </label>

      <label>
        <span>Mobile number</span>
        <input name="phone" autocomplete="tel" inputmode="tel" required />
      </label>

      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" />
      </label>

      <label>
        <span>Preferred day</span>
        <input type="date" name="preferred_day" />
      </label>

      <label>
        <span>Preferred time window</span>
        <select name="preferred_time">
          <option>Morning</option>
          <option>Afternoon</option>
          <option>Evening</option>
          <option>First available</option>
        </select>
      </label>
    </div>

    <label>
      <span>Anything Kaylaa should know?</span>
      <textarea name="message" rows="5" placeholder="First wax, sensitive skin, event date, brow goals, questions, etc."></textarea>
    </label>

    <div class="booking-consent">
      <label class="checkbox-row">
        <input type="checkbox" name="text_ok" value="yes" checked />
        <span>It is okay for SkinByKaylaa to text me about this request.</span>
      </label>
    </div>

    <button class="button button-primary" type="submit">Send booking request</button>
    <p class="form-note">
      This sends a request, not an automatic confirmation. Need help faster? Text <a href={`sms:${business.phoneE164}`}>{business.phoneDisplay}</a>.
    </p>
  </div>

  <script type="application/json" id="addon-pairings" set:html={JSON.stringify(pairingData)} />
</form>
